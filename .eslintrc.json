{
  "extends": [
    "next/core-web-vitals",
    "plugin:@typescript-eslint/recommended",
    "prettier"
  ],
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint", "simple-import-sort"],
  "rules": {
    "simple-import-sort/imports": "error",
    "simple-import-sort/exports": "error",
    "@typescript-eslint/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_" }
    ],
    "@typescript-eslint/no-explicit-any": "warn",
    "prefer-const": "error",
    "no-var": "error",
    "no-restricted-syntax": [
      "error",
      {
        "selector": "Literal[value=/(^|\\s)(bg|text|border|ring|fill|stroke|from|via|to|divide|shadow|outline|placeholder|decoration|accent|caret)-\\[(#|rgba?|hsla?)/]",
        "message": "Do not use arbitrary hex, rgb, or hsl colors (e.g. text-[#...], bg-[rgba(...)], border-[hsl(...)]) in Tailwind classes. Please use standard theme colors from tailwind.config.js."
      },
      {
        "selector": "TemplateElement[value.raw=/(^|\\s)(bg|text|border|ring|fill|stroke|from|via|to|divide|shadow|outline|placeholder|decoration|accent|caret)-\\[(#|rgba?|hsla?)/]",
        "message": "Do not use arbitrary hex, rgb, or hsl colors (e.g. text-[#...], bg-[rgba(...)], border-[hsl(...)]) in Tailwind classes. Please use standard theme colors from tailwind.config.js."
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/lib/profile/saveProfile.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "saveProfile.ts is a deep module and should not import react."
              },
              {
                "name": "next/navigation",
                "message": "saveProfile.ts is a deep module and should not import next/navigation."
              },
              {
                "name": "next-auth/react",
                "message": "saveProfile.ts is a deep module and should not import next-auth/react."
              }
            ],
            "patterns": [
              {
                "group": ["@/hooks/**"],
                "message": "saveProfile.ts is a deep module and should not import from the hooks layer."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/components/ui/calendar.tsx",
        "src/components/ui/avatar-crop-modal.tsx",
        "src/app/mentor-pool/PopularPositionChips.tsx",
        "src/app/mentor-pool/MentorGridSkeleton.tsx",
        "src/components/profile/profile-card/ProfileCard.tsx",
        "src/components/mentor-pool/mentor-card/Information.tsx",
        "src/components/mentor-pool/mentor-card/AvatarWithBadge.tsx",
        "src/components/layout/Header/ShareProfileDialog.tsx",
        "src/app/profile/**/*.tsx",
        "src/app/auth/email-verify/ui.tsx",
        "src/app/auth/email-verified/ui.tsx",
        "src/app/auth/password-forgot-success/page.tsx",
        "src/app/auth/password-reset-success/page.tsx",
        "src/app/auth/password-reset/page.tsx"
      ],
      "rules": {
        "no-restricted-syntax": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "out/",
    "build/",
    "dist/",
    "*.config.js",
    "*.config.ts"
  ]
}
