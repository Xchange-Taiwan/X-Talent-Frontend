{
  "name": "xchange-talent-pool",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev-turbo": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:check": "npm run format:check && npm run lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky install",
    "gemini": "gemini",
    "gemini-yolo": "cross-env GEMINI_CLI_TRUST_WORKSPACE=true gemini --approval-mode=yolo --skip-trust",
    "generate:types": "node scripts/generate-types.mjs",
    "generate:tokens": "node scripts/generate-tokens.mjs",
    "generate:tokens:check": "node scripts/generate-tokens.mjs --check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.6.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@sentry/nextjs": "10",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.21",
    "lucide-react": "^0.316.0",
    "next": "14.2.35",
    "next-auth": "4.24.15",
    "path-to-regexp": "^8.4.2",
    "react": "18.2.0",
    "react-avatar-editor": "^13.0.2",
    "react-day-picker": "^9.8.1",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.83.0",
    "react-swipeable": "^7.0.2",
    "rrule": "^2.8.1",
    "sharp": "^0.35.3",
    "swiper": "^12.1.2",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@google/gemini-cli": "0.52.0",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-onboarding": "^10.5.5",
    "@storybook/blocks": "^8.6.14",
    "@storybook/nextjs": "^10.5.5",
    "@storybook/react": "^10.5.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/node": "20.11.7",
    "@types/react": "18.2.48",
    "@types/react-avatar-editor": "^13.0.3",
    "@types/react-dom": "18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.17",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-storybook": "^10.5.5",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "husky": "^9.0.10",
    "jimp": "^1.6.0",
    "jsdom": "^29.0.2",
    "lint-staged": "^15.2.2",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.33",
    "prettier": "^3.2.4",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "storybook": "^10.5.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "overrides": {
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "glob@>=10.2.0 <10.5.0": "10.5.0"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --cache --fix"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  }
}
